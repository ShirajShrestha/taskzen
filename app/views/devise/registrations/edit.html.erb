<div class="flex flex-col md:flex-row items-center justify-center h-screen bg-white">
    <!-- Image Section -->
    <div class="hidden md:flex w-1/2 h-full items-center justify-center">
        <img src="https://img.freepik.com/free-vector/fill-out-concept-illustration_114360-5540.jpg?t=st=1736237470~exp=1736241070~hmac=f2fe822ace62dcdd5d669a3e8960f8471931d054cf79395844c4988117875935&w=826" alt="TaskZen Vector Illustration" class="object-contain w-3/4 h-3/4">
    </div>

    <!-- Edit Form Section -->
    <div class="w-full md:w-1/2 max-w-md bg-white shadow-lg rounded-lg p-8">
        <h2 class="text-3xl font-bold text-primary mb-6 text-center">Edit Your <span class="text-accent">Profile</span></h2>

        <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { method: :put, class: "space-y-4" }) do |f| %>
        <%= render "devise/shared/error_messages", resource: resource %>

        <!-- Email Field -->
        <div class="space-y-1">
            <%= f.label :email, class: "block text-sm font-medium text-primary" %><br />
            <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "w-full border border-gray-300 rounded-md p-2 focus:ring focus:ring-accent focus:outline-none" %>
        </div>

        <% if devise_mapping.confirmable? && resource.pending_reconfirmation? %>
        <div class="text-sm text-gray-500">
            Currently waiting confirmation for: <%= resource.unconfirmed_email %>
        </div>
        <% end %>

        <!-- Password Field -->
        <div class="space-y-1">
            <%= f.label :password, class: "block text-sm font-medium text-primary" %>
            <em class="text-xs text-gray-500">(leave blank if you don't want to change it)</em><br />
            <%= f.password_field :password, autocomplete: "new-password", class: "w-full border border-gray-300 rounded-md p-2 focus:ring focus:ring-accent focus:outline-none" %>
        </div>

        <!-- Password Confirmation Field -->
        <div class="space-y-1">
            <%= f.label :password_confirmation, class: "block text-sm font-medium text-primary" %><br />
            <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "w-full border border-gray-300 rounded-md p-2 focus:ring focus:ring-accent focus:outline-none" %>
        </div>

        <!-- Current Password Field -->
        <div class="space-y-1">
            <%= f.label :current_password, class: "block text-sm font-medium text-primary" %>
            <em class="text-xs text-gray-500">(we need your current password to confirm your changes)</em><br />
            <%= f.password_field :current_password, autocomplete: "current-password", class: "w-full border border-gray-300 rounded-md p-2 focus:ring focus:ring-accent focus:outline-none" %>
        </div>

        <!-- Submit Button -->
        <div class="mt-4">
            <%= f.submit "Update", class: "w-full bg-accent text-gray-800 py-2 rounded-md hover:bg-accent-light transition focus:ring focus:ring-accent" %>
        </div>
        <% end %>

        <!-- Cancel Account Section -->
        <h3 class="mt-6 text-lg font-bold text-primary">Cancel my account</h3>
        <div class="mt-2 text-sm text-gray-600">
            Unhappy?
            <%= button_to "Cancel my account", registration_path(resource_name), data: { confirm: "Are you sure?", turbo_confirm: "Are you sure?" }, method: :delete, class: "text-red-500 hover:underline" %>
        </div>

        <!-- Back Link -->
        <div class="mt-4 text-sm text-primary">
            <%= link_to "Back", :back, class: "hover:underline" %>
        </div>
    </div>
</div>